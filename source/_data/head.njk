<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9204506101487451" crossorigin="anonymous"></script>
<!-- Global site tag (gtag.js) - Google Analytics -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-ZMM2PZWQSN"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-ZMM2PZWQSN');
</script>
<script async type="application/javascript"
        src="https://news.google.com/swg/js/v1/swg-basic.js"></script>
<script>
  (self.SWG_BASIC = self.SWG_BASIC || []).push( basicSubscriptions => {
    basicSubscriptions.init({
      type: "NewsArticle",
      isPartOfType: ["Product"],
      isPartOfProductId: "CAowzZGfDA:openaccess",
      clientOptions: { theme: "light", lang: "zh-TW" },
    });
  });
</script>
{#- Structured data (JSON-LD) for search engines -#}
{%- set ld_image = 'https://res.cloudinary.com/dn6ricjvz/image/upload/c_fill,w_1200,h_630,q_auto/v1635302756/Fjallraven_pme9iv.jpg' %}
{%- set ld_author = {'@type': 'Person', 'name': config.author, 'url': config.url} %}
{%- if is_post and is_post() %}
{%- set ld_tags = [] %}{%- for t in page.tags.toArray() %}{%- set _ = ld_tags.push(t.name) %}{%- endfor %}
{%- set ld_cats = [] %}{%- for c in page.categories.toArray() %}{%- set _ = ld_cats.push(c.name) %}{%- endfor %}
<script type="application/ld+json">{{ {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  'headline': page.title,
  'description': page.description or config.description,
  'image': [ld_image],
  'datePublished': page.date.toISOString(),
  'dateModified': (page.updated or page.date).toISOString(),
  'author': ld_author,
  'publisher': ld_author,
  'mainEntityOfPage': {'@type': 'WebPage', '@id': page.permalink},
  'url': page.permalink,
  'inLanguage': config.language,
  'articleSection': ld_cats[0] or '',
  'keywords': ld_tags | join(', ')
} | dump | safe }}</script>
{%- elif is_home and is_home() and not page.prev %}
<script type="application/ld+json">{{ {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': config.title,
  'alternateName': config.subtitle,
  'description': config.description,
  'url': config.url,
  'inLanguage': config.language,
  'author': ld_author
} | dump | safe }}</script>
{%- endif %}

{#- Keep thin list pages out of the index but let crawlers follow their links to posts -#}
{%- if page.source == '404.md' or (is_archive and is_archive()) or (is_tag and is_tag()) or (is_category and is_category()) or (is_home and is_home() and page.current > 1) %}
<meta name="robots" content="noindex, follow">
{%- endif %}
